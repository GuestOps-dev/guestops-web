# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_APP_URL=https://your-production-domain.example

# Server-only Supabase configuration (used only by trusted Twilio webhooks)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Twilio webhook and outbound delivery configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Optional local default
DEFAULT_PROPERTY_ID=

# Lodgify (server only). The webhook secret is created when subscribing to
# Lodgify's booking_new_status_booked event and must never be exposed publicly.
LODGIFY_API_KEY=
LODGIFY_WEBHOOK_SECRET=
